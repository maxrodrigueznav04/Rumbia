{
  "name": "rumbo-server",
  "version": "1.0.0",
  "description": "API del Planeador de Viajes con IA (Rumbo)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch-path=./src --watch-preserve-output src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test": "node scripts/smoke-test.mjs",
    "test:api": "node scripts/prueba-api.mjs && node scripts/prueba-edicion.mjs",
    "test:recuperacion": "node scripts/prueba-recuperacion.mjs",
    "test:agencia": "node scripts/prueba-agencia.mjs",
    "test:clima": "node scripts/prueba-clima.mjs",
    "test:baja": "node scripts/prueba-baja.mjs",
    "clicks": "node scripts/clicks.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "zod": "^3.23.8"
  }
}
