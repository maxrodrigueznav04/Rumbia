{
  "name": "rumbia-server",
  "version": "1.0.0",
  "description": "API del Planeador de Viajes con IA (Rumbia)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch-path=./src --watch-preserve-output src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "test": "node scripts/smoke-test.mjs && node --test scripts/resilience.test.mjs scripts/producto.test.mjs",
    "test:carga": "node scripts/load-test.mjs",
    "test:api": "node scripts/prueba-api.mjs && node scripts/prueba-edicion.mjs",
    "test:recuperacion": "node scripts/prueba-recuperacion.mjs",
    "test:agencia": "node scripts/prueba-agencia.mjs",
    "test:clima": "node scripts/prueba-clima.mjs",
    "test:baja": "node scripts/prueba-baja.mjs",
    "clicks": "node scripts/clicks.mjs",
    "cuentas": "node scripts/cuentas.mjs",
    "auditoria": "node scripts/auditoria.mjs",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "gemini:modelos": "node scripts/gemini-modelos.mjs",
    "otorgar-plan": "node scripts/otorgar-plan.mjs"
  },
  "dependencies": {
    "@sentry/node": "10.73.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "stripe": "^22.6.0",
    "zod": "^3.23.8"
  }
}
