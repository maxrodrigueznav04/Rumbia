# ---- Servidor ----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Base de datos ----
# Local:  mongodb://127.0.0.1:27017/rumbia
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rumbia?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rumbia

# ---- Autenticacion ----
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimo 32 caracteres. El servidor rechaza arrancar si esta corto o si se
# deja este mismo valor de ejemplo (es texto publico en este repo).
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ---- Google Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- OpenWeatherMap (https://openweathermap.org/api) ----
OPENWEATHER_API_KEY=

# ---- Correo transaccional (https://resend.com/api-keys) ----
# Sin esta clave la app funciona, pero el enlace de recuperacion no se envia:
# en desarrollo se imprime en la consola del servidor para poder probarlo.
RESEND_API_KEY=
# Mientras no tengas un dominio verificado en Resend, deja el remitente de
# pruebas: solo entrega al correo con el que creaste la cuenta de Resend.
# Con dominio propio pasa a ser algo como: Rumbia <hola@rumbiamx.com>
MAIL_FROM=Rumbia <onboarding@resend.dev>

# ---- Logos de agencia (https://cloudinary.com, plan gratis) ----
# Panel > Dashboard: ahi estan los tres valores juntos, sin que haya que
# generar nada por separado. Sin ellos la app sigue en pie: el boton de subir
# logo responde con un aviso claro, y el campo de URL manual sigue funcionando.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Plantillas visuales (piloto) ----
# Desactivadas por defecto en produccion. Activar solo despues de validar
# Chromium, Cloudinary, permisos y PDF en el despliegue real.
VISUAL_TEMPLATES_ENABLED=
CHROMIUM_PATH=

# ---- Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) ----
# Protege registro y recuperacion de contrasena contra bots. Gratis, sin limite.
# Sin esta clave el captcha queda desactivado (no bloquea nada): no es
# obligatoria para que la app funcione.
TURNSTILE_SECRET_KEY=

# ---- Cobro a agencias (https://dashboard.stripe.com/apikeys) ----
# Sin STRIPE_SECRET_KEY, /agency/billing responde con un aviso claro: el resto
# de la app (uso personal, agencia con un solo dueño) sigue funcionando igual.
STRIPE_SECRET_KEY=
# El secreto de firma del webhook, no la API key. Sale al crear el endpoint
# en el dashboard de Stripe (Developers > Webhooks), apuntando a
# https://tu-api.onrender.com/api/billing/webhook con los eventos
# checkout.session.completed, customer.subscription.updated y
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# Corre "npm run stripe:setup" para crear los Products/Prices en Stripe (en
# MXN y en USD) y que te imprima todas estas lineas ya con los IDs correctos.
# Inicio y Agencia no llevan "_AGENTE" porque esos dos planes no cobran por
# asiento extra. Las variantes "_USD" son opcionales: sin ellas, esos planes
# solo se pueden cobrar en MXN (ver Agency.billing.moneda).
STRIPE_PRICE_INICIO_MENSUAL_BASE=
STRIPE_PRICE_INICIO_ANUAL_BASE=
STRIPE_PRICE_AGENCIA_MENSUAL_BASE=
STRIPE_PRICE_AGENCIA_ANUAL_BASE=
STRIPE_PRICE_PRO_MENSUAL_BASE=
STRIPE_PRICE_PRO_MENSUAL_AGENTE=
STRIPE_PRICE_PRO_ANUAL_BASE=
STRIPE_PRICE_PRO_ANUAL_AGENTE=
STRIPE_PRICE_INICIO_MENSUAL_BASE_USD=
STRIPE_PRICE_INICIO_ANUAL_BASE_USD=
STRIPE_PRICE_AGENCIA_MENSUAL_BASE_USD=
STRIPE_PRICE_AGENCIA_ANUAL_BASE_USD=
STRIPE_PRICE_PRO_MENSUAL_BASE_USD=
STRIPE_PRICE_PRO_MENSUAL_AGENTE_USD=
STRIPE_PRICE_PRO_ANUAL_BASE_USD=
STRIPE_PRICE_PRO_ANUAL_AGENTE_USD=

# ---- Limites de uso ----
AI_RATE_LIMIT_PER_HOUR=10
AI_CHAT_RATE_LIMIT_PER_HOUR=30
# Proteccion de la instancia ante picos de generaciones completas.
AI_MAX_CONCURRENT=3
AI_MAX_QUEUE=6
AI_QUEUE_WAIT_MS=12000

# Correo con reporte de clics (GET /api/stats/clicks) y sin topes de uso:
# generaciones con IA ilimitadas, sin candado de facturacion congelada. No
# salta ningun control de pertenencia (sigue sin ver datos de otras cuentas).
# ADMIN_EMAIL=tu-correo@donde-sea.com

# ---- Programas de afiliados (opcional) ----
# JSON con una entrada por proveedor. Sin esta variable los enlaces salen como
# busquedas publicas, sin identificador y sin declarar comision.
#   "param"     -> agrega un parametro a la URL del proveedor (Booking, Airbnb)
#   "envoltura" -> mete la URL en un redirector; es lo que usa CJ Affiliate
# AFFILIATE_LINKS={"Booking.com":{"tipo":"param","clave":"aid","valor":"TU_ID"},"Skyscanner":{"tipo":"envoltura","plantilla":"https://www.anrdoezrs.net/links/TU_PID/type/dlg/{url}"}}

# ---- Seed ----
SEED_USER_EMAIL=demo@rumbo.app
SEED_USER_PASSWORD=demo1234

# ---- Monitoreo de errores (opcional) ----
# Sin esta variable el monitoreo queda apagado y el servidor corre igual que
# sin esta integracion (ver src/config/sentry.js). DSN gratis en sentry.io.
# SENTRY_DSN=

# ---- Plantillas visuales: beta cerrada, apagada en producción ----
VISUAL_TEMPLATES_ENABLED=false
# IDs de agencias autorizadas, separados por coma. Vacío = nadie.
VISUAL_TEMPLATES_AGENCIES=
# Chromium se instala durante el build solo si la función está habilitada.
# CHROMIUM_PATH= se reserva para un ejecutable administrado externamente.
# Para el servicio separado de prueba: npm run beta:start y base rumbia_visual_beta.
# BETA_OWNER_EMAIL=
# BETA_OWNER_PASSWORD= (contraseña privada de al menos 12 caracteres)
