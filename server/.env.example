# ---- Servidor ----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Base de datos ----
# Local:  mongodb://127.0.0.1:27017/rumbo
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rumbo?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rumbo

# ---- Autenticacion ----
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ---- Google Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- OpenWeatherMap (https://openweathermap.org/api) ----
OPENWEATHER_API_KEY=

# ---- Correo transaccional (https://resend.com/api-keys) ----
# Sin esta clave la app funciona, pero el enlace de recuperacion no se envia:
# en desarrollo se imprime en la consola del servidor para poder probarlo.
RESEND_API_KEY=
# Mientras no tengas un dominio verificado en Resend, deja el remitente de
# pruebas: solo entrega al correo con el que creaste la cuenta de Resend.
# Con dominio propio pasa a ser algo como: Rumbo <hola@turumbo.com>
MAIL_FROM=Rumbo <onboarding@resend.dev>

# ---- Limites de uso ----
AI_RATE_LIMIT_PER_HOUR=10

# ---- Programas de afiliados (opcional) ----
# JSON con una entrada por proveedor. Sin esta variable los enlaces salen como
# busquedas publicas, sin identificador y sin declarar comision.
#   "param"     -> agrega un parametro a la URL del proveedor (Booking, Airbnb)
#   "envoltura" -> mete la URL en un redirector; es lo que usa CJ Affiliate
# AFFILIATE_LINKS={"Booking.com":{"tipo":"param","clave":"aid","valor":"TU_ID"},"Skyscanner":{"tipo":"envoltura","plantilla":"https://www.anrdoezrs.net/links/TU_PID/type/dlg/{url}"}}

# ---- Seed ----
SEED_USER_EMAIL=demo@rumbo.app
SEED_USER_PASSWORD=demo1234
