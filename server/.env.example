# ---- Servidor ----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Base de datos ----
# Local:  mongodb://127.0.0.1:27017/rumbo
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/rumbo?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rumbo

# ---- Autenticacion ----
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=7d

# ---- Google Gemini (https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- OpenWeatherMap (https://openweathermap.org/api) ----
OPENWEATHER_API_KEY=

# ---- Limites de uso ----
AI_RATE_LIMIT_PER_HOUR=10

# ---- Seed ----
SEED_USER_EMAIL=demo@rumbo.app
SEED_USER_PASSWORD=demo1234
