# URL del backend. En desarrollo se puede dejar vacio: Vite proxea /api al puerto 4000.
# En produccion apunta al backend desplegado, ej. https://rumbia-api.onrender.com/api
# (Vite lo incrusta al compilar: tiene que existir antes de "npm run build", no
# se configura despues en ningun dashboard de Cloudflare).
VITE_API_URL=

# Llave PUBLICA de Cloudflare Turnstile (la "Site Key", no la secreta: esa va
# solo en el servidor). Sin ella no se muestra el widget de verificacion
# humana en el registro, y el formulario sigue funcionando igual que antes.
VITE_TURNSTILE_SITE_KEY=

# Monitoreo de errores (opcional, gratis en sentry.io). Sin esta variable el
# monitoreo queda apagado y la app corre igual que sin esta integracion.
VITE_SENTRY_DSN=

# Beta cerrada: exige también autorización de la agencia desde la API.
VITE_ENABLE_VISUAL_TEMPLATES=false
