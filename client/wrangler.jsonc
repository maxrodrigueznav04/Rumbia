{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nombre del proyecto en Cloudflare. Cambiar esto y correr "npm run deploy"
  // crea un Worker NUEVO en ese nombre -- no renombra el que ya existe. El
  // viejo ("rumbo") se queda huerfano en el dashboard hasta que se borre a
  // mano ahi mismo.
  "name": "rumbo-app",
  "compatibility_date": "2026-08-28",

  // Sin Worker script: esto es solo el build estatico de Vite (dist/) servido
  // como asset. "single-page-application" hace que cualquier ruta que no sea
  // un archivo real (ej. /viajes/abc123) caiga a index.html en vez de dar 404,
  // que es lo que necesita el ruteo de react-router en el navegador.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // Custom Domains del Worker. IMPORTANTE: wrangler trata este arreglo como
  // la lista COMPLETA de dominios personalizados -- no es aditivo. La
  // primera vez que se agrego www.rumbiamx.com aqui, dejar fuera a
  // rumbiamx.com (que se habia configurado a mano desde el dashboard,
  // pensando que asi quedaba "intacto") hizo que el deploy lo quitara del
  // Worker sin avisar claramente -- rumbiamx.com dejo de resolver (NXDOMAIN)
  // hasta que se agrego aqui tambien. Los dos tienen que estar siempre
  // listados juntos.
  "routes": [
    { "pattern": "rumbiamx.com", "custom_domain": true },
    { "pattern": "www.rumbiamx.com", "custom_domain": true }
  ]
}
