{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nombre del proyecto en Cloudflare. Cambiar esto y correr "npm run deploy"
  // crea un Worker NUEVO en ese nombre -- no renombra el que ya existe. El
  // viejo ("rumbo") se queda huerfano en el dashboard hasta que se borre a
  // mano ahi mismo.
  "name": "rumbo-app",
  "compatibility_date": "2026-08-28",

  // Sin Worker script: esto es solo el build estatico de Vite (dist/) servido
  // como asset. "single-page-application" hace que cualquier ruta que no sea
  // un archivo real (ej. /viajes/abc123) caiga a index.html en vez de dar 404,
  // que es lo que necesita el ruteo de react-router en el navegador.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
